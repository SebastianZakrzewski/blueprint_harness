{
  "name": "@blueprint-harness/root",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test && vitest run --config vitest.config.ts",
    "lint": "echo lint stub",
    "harness": "pnpm --filter @blueprint-harness/cli exec harness",
    "gate": "pnpm -r build && node --experimental-strip-types scripts/gates/harness-blueprint-v1-gate.ts",
    "gate:platform-query-api": "pnpm -r build && node --experimental-strip-types scripts/gates/platform-query-api-ready-gate.ts",
    "gate:control-panel-pilot": "pnpm -r build && node --experimental-strip-types scripts/gates/control-panel-pilot-ready-gate.ts",
    "gate:platform-v1-1": "pnpm -r build && node --experimental-strip-types scripts/gates/harness-platform-v1-1-gate.ts"
  },
  "devDependencies": {
    "@blueprint-harness/cli": "workspace:*",
    "@blueprint-harness/core": "workspace:*",
    "@types/node": "^22.15.21",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
